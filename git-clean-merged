#!/bin/bash
#
# git-clean-merged helps with cleanup of merged branches in local and remote repositories
#
# Copyright(c) 2026       Christoph Niethammer <christoph.niethammer@gmail.com>
#
# Every expected failure is handled explicitly below. As a safety net, any
# other failing command ends the script via on_error with a clear message
# and the documented exit status (see usage). -E makes the trap apply inside
# functions too; avoid process substitution, where it would fire spuriously.
set -eE
#set -x

DELETION_STARTED=false   # set before the first branch is deleted

# Colors: O_* for stdout, E_* for stderr; empty until setup_colors enables them
O_BOLD="" O_DIM="" O_GREEN="" O_YELLOW="" O_RED="" O_RESET=""
E_BOLD="" E_YELLOW="" E_RED="" E_CYAN="" E_RESET=""

error() { echo "${E_RED}${E_BOLD}error:${E_RESET} $*" >&2; }
warn()  { echo "${E_YELLOW}${E_BOLD}warning:${E_RESET} $*" >&2; }
note()  { echo "${E_CYAN}note:${E_RESET} $*" >&2; }
hint()  { echo "${E_CYAN}hint:${E_RESET} $*" >&2; }

# Invoked via the ERR trap, which shellcheck cannot see. Reported as SC2329
# by shellcheck >= 0.11 and as SC2317 by older versions.
# shellcheck disable=SC2317,SC2329
on_error() {
  local rc=$?
  # In a $(...) subshell just pass the status on; the main shell reports it
  (( BASHPID == $$ )) || exit "$rc"
  trap - ERR
  error "unexpected failure (exit status $rc) at line ${BASH_LINENO[0]}: $BASH_COMMAND"
  if $DELETION_STARTED; then exit 2; else exit 1; fi
}
trap on_error ERR

# Default values
BASE_BRANCH=""   # empty: detect from $REMOTE_TARGET/HEAD
REMOTE_TARGET=""   # empty: detect (push remote, upstream, sole remote, origin)
DRYRUN=false
PROTECTED_BRANCHES="main|master|develop"
COLOR=auto
SCOPE=all   # all, local or remote

usage() {
  echo "Usage: ${0##*/} [options]"
  echo
  echo "Delete local and remote branches that are merged into the base branch."
  echo
  echo "Options:"
  echo "  -b, --base <branch>       Base branch to check merges against (default: default branch of the remote)"
  echo "  -n, --dry-run             Preview which branches would be deleted without deleting"
  echo "  -p, --protected <regex>   Regex of branches to protect from deletion (default: $PROTECTED_BRANCHES)"
  echo "  -r, --remote <remote>     Remote target to update (default: push remote of the current branch)"
  echo "  -L, --local-only          Only delete local branches"
  echo "  -R, --remote-only         Only delete branches on the remote"
  echo "      --color[=<when>]      Colorize output: always, never or auto (default: auto)"
  echo "  -h, --help                Show this help"
  echo
  echo "Exit status:"
  echo "  0  all selected branches were deleted (or would be, in a dry run)"
  echo "  1  error before anything was deleted (invalid options, setup problems)"
  echo "  2  partial cleanup: a deletion failed or the remote cleanup was skipped"
}

# Print "true" if a stream should be colored in auto mode; $1 is "true" if
# the stream is a terminal. Colors also need TERM other than dumb, NO_COLOR
# unset, and git's color.ui (or color.cleanmerged) not saying otherwise.
auto_color() {
  local tty=$1
  if [[ -n ${NO_COLOR-} ]]; then echo false; return 0; fi
  if [[ ${TERM:-dumb} == dumb ]]; then tty=false; fi
  git config --get-colorbool color.cleanmerged "$tty" 2>/dev/null || echo "$tty"
}

# Enable colors per stream according to $1 (always, never, auto)
setup_colors() {
  local out err tty_out=false tty_err=false
  # Test for a terminal here: inside $(...) stdout is always a pipe
  if [[ -t 1 ]]; then tty_out=true; fi
  if [[ -t 2 ]]; then tty_err=true; fi
  case $1 in
    always) out=true; err=true ;;
    never) out=false; err=false ;;
    auto) out=$(auto_color "$tty_out"); err=$(auto_color "$tty_err") ;;
  esac
  if [[ $out == true ]]; then
    O_BOLD=$'\e[1m' O_DIM=$'\e[2m' O_GREEN=$'\e[32m' O_YELLOW=$'\e[33m' O_RED=$'\e[31m' O_RESET=$'\e[0m'
  fi
  if [[ $err == true ]]; then
    E_BOLD=$'\e[1m' E_YELLOW=$'\e[33m' E_RED=$'\e[31m' E_CYAN=$'\e[36m' E_RESET=$'\e[0m'
  fi
}

# Return 0 if $1 matches the protected pattern as a whole name
is_protected() {
  local rc=0
  grep -qxE -- "$PROTECTED_BRANCHES" <<< "$1" || rc=$?
  if (( rc == 2 )); then
    error "invalid --protected regex: $PROTECTED_BRANCHES"
    exit 1
  fi
  return "$rc"
}

# Add $1 as a literal name to PROTECTED_BRANCHES unless it already matches;
# $2 describes the branch in the warning
ensure_protected() {
  local c i escaped=""
  is_protected "$1" && return 0
  warn "$2 is not matched by the protected pattern; protecting it automatically"
  # Put regex metacharacters into bracket expressions so the name matches literally
  # (git already forbids * ? [ ^ \ in branch names)
  for (( i = 0; i < ${#1}; i++ )); do
    c=${1:i:1}
    if [[ '].+(){}|$' == *"$c"* ]]; then escaped+="[$c]"; else escaped+=$c; fi
  done
  PROTECTED_BRANCHES="$PROTECTED_BRANCHES|$escaped"
}

# Exit unless git is at least 2.23 (needed for for-each-ref %(worktreepath))
check_git_version() {
  local version major minor
  if ! version=$(git --version 2>/dev/null); then   # e.g. "git version 2.39.3 (Apple Git-145)"
    error "git not found"
    exit 1
  fi
  IFS=. read -r major minor _ <<< "${version#git version }"
  if ! [[ $major =~ ^[0-9]+$ && $minor =~ ^[0-9]+$ ]] ||
     (( major < 2 || (major == 2 && minor < 23) )); then
    error "git 2.23 or newer is required (found: $version)"
    exit 1
  fi
}

# Print the remote to clean up; return 1 if none can be determined
detect_remote() {
  local branch key remote remotes
  if branch=$(git symbolic-ref --quiet --short HEAD); then
    for key in "branch.$branch.pushRemote" remote.pushDefault "branch.$branch.remote"; do
      if remote=$(git config --get "$key") && [[ $remote != . ]]; then
        echo "$remote"; return 0
      fi
    done
  elif remote=$(git config --get remote.pushDefault); then
    echo "$remote"; return 0
  fi
  remotes=$(git remote)
  if [[ -n $remotes && $remotes != *$'\n'* ]]; then   # exactly one remote
    echo "$remotes"; return 0
  fi
  if git remote get-url origin >/dev/null 2>&1; then
    echo origin; return 0
  fi
  return 1
}

# ---- Report: rows are collected per section and printed by print_section

ROW_NAMES=() ROW_STATES=() ROW_COLORS=()
SKIP_NAMES=() SKIP_REASONS=()
n_deleted=0 n_failed=0 n_skipped=0

add_row() { ROW_NAMES+=("$1"); ROW_STATES+=("$2"); ROW_COLORS+=("$3"); }
skip()    { SKIP_NAMES+=("$1"); SKIP_REASONS+=("$2"); }

# Append the collected skipped branches as rows after the deletions
add_skip_rows() {
  local i
  for i in "${!SKIP_NAMES[@]}"; do
    add_row "${SKIP_NAMES[i]}" "skipped: ${SKIP_REASONS[i]}" "$O_DIM"
  done
  n_skipped=$(( n_skipped + ${#SKIP_NAMES[@]} ))
  SKIP_NAMES=() SKIP_REASONS=()
}

# Print title $1 and the collected rows as an aligned table, then reset them;
# $2 (optional) replaces the rows with a message, e.g. why the section was skipped
print_section() {
  local i width=0
  echo
  echo "${O_BOLD}$1${O_RESET}"
  if [[ -n ${2-} ]]; then
    echo "  ${O_YELLOW}$2${O_RESET}"
  elif (( ${#ROW_NAMES[@]} == 0 )); then
    echo "  ${O_DIM}no merged branches${O_RESET}"
  fi
  for i in "${!ROW_NAMES[@]}"; do
    if (( ${#ROW_NAMES[i]} > width )); then width=${#ROW_NAMES[i]}; fi
  done
  for i in "${!ROW_NAMES[@]}"; do
    printf '  %-*s  %s%s%s\n' "$width" "${ROW_NAMES[i]}" "${ROW_COLORS[i]}" "${ROW_STATES[i]}" "$O_RESET"
  done
  ROW_NAMES=() ROW_STATES=() ROW_COLORS=()
}

# Restrict the cleanup to "local" or "remote"; the two are mutually exclusive
set_scope() {
  if [[ $SCOPE != all && $SCOPE != "$1" ]]; then
    error "--local-only and --remote-only cannot be combined"
    exit 1
  fi
  SCOPE=$1
}

# "1 branch", "2 branches"
branches() { if (( $1 == 1 )); then echo "1 branch"; else echo "$1 branches"; fi; }

# ---- Arguments

if ! TEMP=$(getopt -o b:np:r:hLR --long base:,dry-run,protected:,remote:,local-only,remote-only,color::,help -n "${0##*/}" -- "$@"); then
  usage >&2
  exit 1
fi
eval set -- "$TEMP"

while true; do
  case "$1" in
    -b|--base) BASE_BRANCH="$2"; shift 2 ;;
    -n|--dry-run) DRYRUN=true; shift ;;
    -p|--protected) PROTECTED_BRANCHES="$2"; shift 2 ;;
    -r|--remote) REMOTE_TARGET=$2; shift 2 ;;
    -L|--local-only) set_scope local; shift ;;
    -R|--remote-only) set_scope remote; shift ;;
    --color)
      case ${2:-always} in   # plain --color means always, like git
        always|never|auto) COLOR=${2:-always} ;;
        *) error "invalid --color value '$2' (expected always, never or auto)"; exit 1 ;;
      esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) error "invalid option: $1"; usage >&2; exit 1 ;;
  esac
done

if (( $# > 0 )); then
  error "unexpected argument: $1"
  usage >&2
  exit 1
fi

setup_colors "$COLOR"

# ---- Setup and checks

check_git_version

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  error "not inside a git repository"
  exit 1
fi

if [[ -z $REMOTE_TARGET ]] && ! REMOTE_TARGET=$(detect_remote); then
  remotes=$(git remote)
  if [[ -z $remotes ]]; then
    error "no remotes configured in this repository"
    hint "add one with: git remote add <name> <url>"
  else
    error "cannot detect which remote to clean up; found: ${remotes//$'\n'/ }"
    hint "pass -r <remote>, or set a default with: git config remote.pushDefault <remote>"
  fi
  exit 1
fi

if ! git remote get-url "$REMOTE_TARGET" >/dev/null 2>&1; then
  error "remote '$REMOTE_TARGET' does not exist; configured remotes: $(git remote | tr '\n' ' ')"
  exit 1
fi

# Fetch and prune first, so remote refs and $REMOTE_TARGET/HEAD are current
if ! git fetch --quiet --prune "$REMOTE_TARGET"; then
  error "fetching from remote '$REMOTE_TARGET' failed"
  exit 1
fi

# Default branch of the remote: from the local $REMOTE_TARGET/HEAD ref,
# else ask the server
REMOTE_DEFAULT=""
if head_ref=$(git symbolic-ref --quiet "refs/remotes/$REMOTE_TARGET/HEAD"); then
  REMOTE_DEFAULT=${head_ref#"refs/remotes/$REMOTE_TARGET/"}
else
  # Output line of interest: "ref: refs/heads/<branch><TAB>HEAD"
  ls_remote=$(git ls-remote --symref "$REMOTE_TARGET" HEAD 2>/dev/null || true)
  while IFS=$'\t' read -r ref name; do
    if [[ $name == HEAD && $ref == "ref: refs/heads/"* ]]; then
      REMOTE_DEFAULT=${ref#"ref: refs/heads/"}
    fi
  done <<< "$ls_remote"
fi

if [[ -z $BASE_BRANCH ]]; then
  if [[ -n $REMOTE_DEFAULT ]]; then
    BASE_BRANCH=$REMOTE_DEFAULT
  else
    error "cannot detect base branch: default branch of remote '$REMOTE_TARGET' is unknown"
    hint "pass -b <branch>, or run: git remote set-head $REMOTE_TARGET --auto"
    exit 1
  fi
fi

status=0             # becomes 2 on partial cleanup, see usage
remote_skip=""       # reason why remote cleanup is skipped, if it is

# Always protect the base branch and the remote's default branch
ensure_protected "$BASE_BRANCH" "base branch '$BASE_BRANCH'"
# A problem on the remote side only matters if the remote is cleaned up:
# with --remote-only it is an error, with --local-only just a note
if [[ -z $REMOTE_DEFAULT ]]; then
  case $SCOPE in
    remote)
      error "default branch of remote '$REMOTE_TARGET' is unknown, so it cannot be protected"
      hint "set it with: git remote set-head $REMOTE_TARGET <branch>"
      exit 1 ;;
    local)
      note "default branch of remote '$REMOTE_TARGET' is unknown and not protected automatically" ;;
    all)
      warn "default branch of remote '$REMOTE_TARGET' is unknown, so it cannot be protected;" \
        "remote branches will NOT be deleted"
      hint "set it with: git remote set-head $REMOTE_TARGET <branch>"
      remote_skip="skipped: default branch of the remote is unknown"
      status=2 ;;
  esac
elif [[ $REMOTE_DEFAULT != "$BASE_BRANCH" ]]; then
  ensure_protected "$REMOTE_DEFAULT" "default branch '$REMOTE_DEFAULT' of remote '$REMOTE_TARGET'"
fi

# The base branch must exist locally, on the remote, or both
local_base="refs/heads/$BASE_BRANCH"
remote_base="refs/remotes/$REMOTE_TARGET/$BASE_BRANCH"
local_base_name=$BASE_BRANCH
has_local_base=false
has_remote_base=false
git rev-parse --verify --quiet "$local_base^{commit}" >/dev/null && has_local_base=true
git rev-parse --verify --quiet "$remote_base^{commit}" >/dev/null && has_remote_base=true
if ! $has_local_base && ! $has_remote_base; then
  error "base branch '$BASE_BRANCH' exists neither locally nor on remote '$REMOTE_TARGET'"
  exit 1
fi
if ! $has_local_base && [[ $SCOPE != remote ]]; then
  note "no local branch '$BASE_BRANCH'; checking local branches against '$REMOTE_TARGET/$BASE_BRANCH'"
  local_base=$remote_base
  local_base_name="$REMOTE_TARGET/$BASE_BRANCH"
fi
if ! $has_remote_base; then
  if [[ $SCOPE == remote ]]; then
    error "base branch '$BASE_BRANCH' does not exist on remote '$REMOTE_TARGET'"
    exit 1
  elif [[ $SCOPE == all ]]; then
    warn "base branch '$BASE_BRANCH' does not exist on remote '$REMOTE_TARGET';" \
      "remote branches will NOT be deleted"
    remote_skip="skipped: base branch does not exist on the remote"
    status=2
  fi
fi

# ---- Header

if $DRYRUN; then
  echo "${O_BOLD}Merged branch cleanup${O_RESET} ${O_YELLOW}(dry run: nothing will be deleted)${O_RESET}"
else
  echo "${O_BOLD}Merged branch cleanup${O_RESET}"
fi
echo "  remote     $REMOTE_TARGET"
echo "  base       $BASE_BRANCH"
echo "  protected  $PROTECTED_BRANCHES"
case $SCOPE in
  local)  echo "  scope      local branches only" ;;
  remote) echo "  scope      remote branches only" ;;
esac

# ---- Local branches

if [[ $SCOPE != remote ]]; then
  current_ref=$(git symbolic-ref --quiet HEAD || true)  # empty on detached HEAD
  refs=$(git for-each-ref --format='%(refname)%09%(worktreepath)' \
    --merged "$local_base" refs/heads/)
  local_branches=()
  while IFS=$'\t' read -r ref worktree; do
    [[ -z $ref ]] && continue
    branch=${ref#refs/heads/}
    if [[ $ref == "$current_ref" ]]; then
      skip "$branch" "currently checked out"
    elif [[ $branch == "$BASE_BRANCH" ]]; then
      skip "$branch" "base branch"
    elif is_protected "$branch"; then
      skip "$branch" "protected"
    elif [[ -n $worktree ]]; then
      skip "$branch" "checked out in worktree $worktree"
    else
      local_branches+=("$branch")
    fi
  done <<< "$refs"

  for branch in "${local_branches[@]}"; do
    if $DRYRUN; then
      add_row "$branch" "would delete" "$O_GREEN"
      n_deleted=$(( n_deleted + 1 ))
      continue
    fi
    DELETION_STARTED=true
    if out=$(git branch -d "$branch" 2>&1); then
      add_row "$branch" "deleted" "$O_GREEN"
      n_deleted=$(( n_deleted + 1 ))
    else
      out=${out%%$'\n'*}   # first line of git's message, e.g. "error: ... not fully merged"
      add_row "$branch" "failed: ${out#error: }" "$O_RED"
      n_failed=$(( n_failed + 1 ))
      status=2
    fi
  done
  add_skip_rows
  print_section "Local branches merged into $local_base_name"
fi

# ---- Remote branches (skipped entirely if the remote's default branch is
# unknown or the base branch does not exist on the remote)

remote_title="Branches on remote '$REMOTE_TARGET' merged into $REMOTE_TARGET/$BASE_BRANCH"
if [[ $SCOPE == local ]]; then
  :   # --local-only
elif [[ -n $remote_skip ]]; then
  print_section "$remote_title" "$remote_skip (see warning above)"
else
  remote_prefix="refs/remotes/$REMOTE_TARGET/"
  refs=$(git for-each-ref --format='%(refname)' --merged "$remote_base" "$remote_prefix")
  remote_branches=()
  while IFS= read -r ref; do
    [[ -z $ref ]] && continue
    branch=${ref#"$remote_prefix"}
    if [[ $branch == HEAD ]]; then
      continue
    elif [[ $branch == "$BASE_BRANCH" ]]; then
      skip "$branch" "base branch"
    elif is_protected "$branch"; then
      skip "$branch" "protected"
    else
      remote_branches+=("$branch")
    fi
  done <<< "$refs"

  push_out=""
  if (( ${#remote_branches[@]} )) && ! $DRYRUN; then
    DELETION_STARTED=true
    echo
    echo "${O_DIM}Deleting $(branches ${#remote_branches[@]}) on '$REMOTE_TARGET' ...${O_RESET}"
    if ! push_out=$(git push --quiet "$REMOTE_TARGET" --delete "${remote_branches[@]}" 2>&1); then
      status=2
    fi
  fi
  for branch in "${remote_branches[@]}"; do
    if $DRYRUN; then
      add_row "$branch" "would delete" "$O_GREEN"
      n_deleted=$(( n_deleted + 1 ))
    # A successful push also removes the remote-tracking ref
    elif git rev-parse --verify --quiet "$remote_prefix$branch" >/dev/null; then
      add_row "$branch" "failed (see git output below)" "$O_RED"
      n_failed=$(( n_failed + 1 ))
    else
      add_row "$branch" "deleted" "$O_GREEN"
      n_deleted=$(( n_deleted + 1 ))
    fi
  done
  add_skip_rows
  print_section "$remote_title"
  if (( status != 0 )) && [[ -n $push_out ]]; then
    echo
    echo "${O_DIM}git push output:${O_RESET}"
    while IFS= read -r line; do echo "  ${O_DIM}$line${O_RESET}"; done <<< "$push_out"
  fi
fi

# ---- Summary

echo
if $DRYRUN; then
  summary="$(branches "$n_deleted") would be deleted, $n_skipped skipped"
else
  summary="$(branches "$n_deleted") deleted, $n_failed failed, $n_skipped skipped"
fi
if (( status != 0 )); then
  echo "${O_BOLD}Summary:${O_RESET} $summary ${O_RED}(finished with errors, exit status $status)${O_RESET}"
else
  echo "${O_BOLD}Summary:${O_RESET} $summary"
fi
exit "$status"
